# SPOS Environment Configuration

# Server Port
PORT=8080

# Database Configuration
# Driver options: "sqlite" or "postgres"
DB_DRIVER=sqlite
# DSN for SQLite: "spos.db"
# DSN for PostgreSQL: "host=localhost user=postgres password=secret dbname=spos port=5432 sslmode=disable"
DB_DSN=spos.db

# JWT Secret Key
JWT_SECRET=spos-super-secret-jwt-key-2026

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder
MIDTRANS_IS_PRODUCTION=false
