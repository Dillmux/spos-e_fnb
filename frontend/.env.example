# SvelteKit / Vite Frontend Environment Variables Example

# Client-side API Base URL (accessible via import.meta.env.PUBLIC_API_BASE_URL)
PUBLIC_API_BASE_URL=/api/v1

# Application Identity & Branding
PUBLIC_APP_NAME="Smart POS & Resto"
PUBLIC_APP_VERSION="1.0.0"

# Vite Dev Server Configuration
VITE_PORT=5173
VITE_BACKEND_TARGET=http://localhost:8080
